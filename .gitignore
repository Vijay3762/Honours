# ============================================================
# RISC-V CNN SoC - Honours Project
# Git Ignore File
# ============================================================


# ============================================================
# VCS / Synopsys Simulation Generated Files
# ============================================================

# VCS executable and generated simulation files
simv
simv.*
simv.daidir/

# VCS compilation directory
csrc/
*.daidir/

# VCS DVE files
DVEfiles/

# VCS UCLI
ucli.key

# VCS waveform/database files
*.vpd
*.fsdb
*.vcd
*.wlf

# VCS coverage files
urgReport/
coverage/
simv.vdb/

# VCS generated libraries
*.so
*.a

# Keep simulation directory structure
sim/vcs/*
!sim/vcs/.gitkeep


# ============================================================
# Verilog / SystemVerilog Simulator Generated Files
# ============================================================

*.log
*.jou
*.history
*.key

# Temporary simulator files
*.tmp
*.bak
*.swp
*.swo
*~


