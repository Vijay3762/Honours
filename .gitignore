# ------------------------------------------------------------
# 6. Explicit Exceptions (Preserve Important Tracked Files)
# ------------------------------------------------------------
# Preserve empty directory markers
!.gitkeep

# Preserve memory hex files for testbench firmware & ICCM
!my_test/*.hex
!*.hex

# Preserve Verdi signal configuration scripts in script/
!script/*.rc
!script/*.tcl
