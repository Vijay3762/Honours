## 7-Segment Display: Cathodes (active-low CA..CG)
set_property PACKAGE_PIN W7 [get_ports {seven_seg_seg_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {seven_seg_seg_o[0]}]
set_property PACKAGE_PIN W6 [get_ports {seven_seg_seg_o[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {seven_seg_seg_o[1]}]
